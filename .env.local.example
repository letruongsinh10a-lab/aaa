# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dev-only: direct (non-pooled, port 5432) Postgres connection string, used by
# `npm run db:push` (drizzle-kit). Never set this in Vercel — no runtime code
# imports Drizzle, all app reads/writes go through the Supabase client + RLS.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
